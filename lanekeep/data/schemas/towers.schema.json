{
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["family","name","antiAir","targeting","tiers"],
    "properties": {
      "family": { "enum": ["rangedPhysical","meleeBarracks","magic","areaArtillery"] },
      "name": { "type": "string" },
      "antiAir": { "type": "boolean" },
      "targeting": { "enum": ["furthestAlongPath"] },
      "tiers": {
        "type": "array", "minItems": 1,
        "items": {
          "type": "object", "additionalProperties": false,
          "required": ["cost","range","damage","damageType","cooldown","projectile"],
          "properties": {
            "cost": { "type": "number", "minimum": 0 },
            "range": { "type": "number", "exclusiveMinimum": 0 },
            "damage": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0 } },
            "damageType": { "enum": ["physical","magic","true"] },
            "cooldown": { "type": "number", "exclusiveMinimum": 0 },
            "projectile": {
              "type": "object", "additionalProperties": false, "required": ["speed","lead"],
              "properties": { "speed": { "type": "number", "exclusiveMinimum": 0 }, "lead": { "type": "boolean" } }
            }
          }
        }
      },
      "specializations": { "type": "object" }
    }
  }
}
