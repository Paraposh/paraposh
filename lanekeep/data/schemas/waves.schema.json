              "required": ["enemyId","count","interval","startDelay","path"],
              "properties": {
                "enemyId": { "type": "string" },
                "count": { "type": "integer", "minimum": 1 },
                "interval": { "type": "number", "minimum": 0 },
                "startDelay": { "type": "number", "minimum": 0 },
                "path": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "bosses": { "type": "object" }
  }
}
