{
  "type": "object",
  "additionalProperties": false,
  "required": ["upgrades"],
  "properties": {
    "upgrades": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "branch", "maxRank", "costs", "effect"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "branch": { "type": "string", "minLength": 1 },
          "maxRank": { "type": "integer", "minimum": 1, "maximum": 10 },
          "costs": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
          "effect": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "perRank"],
            "properties": {
              "kind": { "enum": ["startGold", "startLives", "towerDamage", "spellCooldown", "heroHp"] },
              "perRank": { "type": "number", "exclusiveMinimum": 0 }
            }
          },
          "requires": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "rank"],
            "properties": { "id": { "type": "string" }, "rank": { "type": "integer", "minimum": 1 } }
          }
        }
      }
    }
  }
}
